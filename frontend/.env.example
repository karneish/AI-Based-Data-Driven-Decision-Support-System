# DSS-MIP frontend environment
# ------------------------------------------------------------
# Base URL of the FastAPI backend.
# In development you can run the API locally:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# In production (Vercel build) it defaults to the Render backend,
# so this can be left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
