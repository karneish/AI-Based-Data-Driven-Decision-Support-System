# DSS-MIP environment configuration
# Copy this file to .env and adjust as needed.

# --- Backend (FastAPI on Render) ---
# Backend process runs inside Docker; port injected by the platform.
BACKEND_PORT=8000

# Where / on the API redirects visitors (the Vercel frontend URL).
# FRONTEND_URL=https://ai-dss-three.vercel.app

# --- Frontend (Next.js on Vercel) ---
# In production the frontend defaults to https://dss-mip.onrender.com.
# Override only if your Render service uses a different URL.
# NEXT_PUBLIC_API_BASE_URL=https://dss-mip.onrender.com
