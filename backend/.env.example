# DSS-MIP Backend configuration
APP_NAME=DSS-MIP API
APP_DESCRIPTION=AI-Based Data-Driven Decision Support System
APP_DEBUG=true

# Comma-separated list of allowed CORS origins, e.g. https://dss-mip.vercel.app
CORS_ORIGINS=*

# Signed-cookie session secret — set a long random value in production
SESSION_SECRET=dss-mip-dev-secret-change-me-in-production
SESSION_MAX_AGE=86400
