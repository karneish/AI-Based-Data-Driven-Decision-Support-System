# DSS-MIP Backend configuration
APP_NAME=DSS-MIP API
APP_DESCRIPTION=AI-Based Data-Driven Decision Support System
APP_DEBUG=true

# Comma-separated list of allowed CORS origins, e.g. https://ai-dss-three.vercel.app
# The Next.js frontend calls the API cross-origin; no credentials are sent.
CORS_ORIGINS=*

# Where / on the API redirects visitors
FRONTEND_URL=https://ai-dss-three.vercel.app
